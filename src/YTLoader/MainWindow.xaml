<ui:FluentWindow x:Class="YTLoader.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="YTLoader"
                 Width="760" Height="740" MinWidth="640" MinHeight="740"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/YTLoader.ico"
                 FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <!-- 카드 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- 입력 위 작은 제목 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- 로딩 자리 표시 막대 -->
        <Style x:Key="Skeleton" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- 모드 선택 (세그먼트 버튼) -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Padding="16,6" CornerRadius="5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 포맷 / 품질 칩 목록 -->
        <Style x:Key="Chips" TargetType="ItemsControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Margin="0,0,6,6" Padding="8,2" CornerRadius="4"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 제목 표시줄 ================= -->
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="YTLoader">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/YTLoader.ico" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 로그인 (비공개 · 연령 제한 · 멤버십 영상용 쿠키) -->
                    <ui:Button x:Name="BtnAccount" Appearance="Transparent" BorderThickness="0" Padding="10,4"
                               Click="BtnAccount_Click" ToolTip="YouTube 로그인 (비공개 · 연령 제한 · 멤버십 영상)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PersonCircle24" FontSize="18" />
                            <TextBlock x:Name="TxtAccount" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="MenuLoginStatus" IsEnabled="False" />
                                <MenuItem x:Name="MenuUseCookies" Header="다운로드에 로그인 사용" IsCheckable="True" IsChecked="True"
                                          ToolTip="공개 영상만 받을 때는 해제해도 됩니다. (계정 보호를 위해 보조 계정 사용 권장)" />
                                <Separator />
                                <MenuItem x:Name="MenuLogin" Header="로그인…" Click="MenuLogin_Click"
                                          ToolTip="로그인 전용 브라우저 창을 열어 YouTube에 로그인합니다.&#x0a;로그인이 확인되면 쿠키를 저장하고 창을 자동으로 닫습니다." />
                                <MenuItem x:Name="MenuLogout" Header="로그아웃" Click="MenuLogout_Click" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                    <!-- 더보기 -->
                    <ui:Button x:Name="BtnMore" Appearance="Transparent" BorderThickness="0" Padding="8,4" Margin="2,0,8,0"
                               Icon="{ui:SymbolIcon MoreHorizontal24}" Click="BtnMore_Click" ToolTip="더보기">
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="MenuYtDlpUpdate" Header="yt-dlp 업데이트" Click="MenuYtDlpUpdate_Click"
                                          ToolTip="YouTube 변경으로 다운로드가 실패할 때 yt-dlp를 최신 버전으로 업데이트합니다." />
                                <Separator />
                                <MenuItem x:Name="MenuYtDlpVersion" IsEnabled="False" />
                                <MenuItem x:Name="MenuAppVersion" IsEnabled="False" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- ================= 본문 ================= -->
        <StackPanel Grid.Row="1" Margin="24,4,24,16">

            <!-- URL 입력 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TxtUrl" Icon="{ui:SymbolIcon Link24}" PlaceholderText="YouTube 링크를 붙여넣으세요"
                            ClearButtonEnabled="True" FontSize="14" TextChanged="TxtUrl_TextChanged" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Padding="14,0"
                           Icon="{ui:SymbolIcon ClipboardPaste24}" Content="붙여넣기" Click="BtnPaste_Click" />
            </Grid>

            <!-- 미리보기 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16" Height="178">
                <Grid>
                    <!-- 빈 상태 -->
                    <StackPanel x:Name="PreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="VideoClip24" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="링크를 붙여넣으면 영상 정보가 여기에 표시됩니다" />
                    </StackPanel>

                    <!-- 불러오는 중 -->
                    <Grid x:Name="PreviewLoading" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="256" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="SkeletonGroup" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.4" Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                        <Grid x:Name="SkeletonGroup" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="256" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Skeleton}" Width="256" Height="144" CornerRadius="8" />
                            <StackPanel Grid.Column="1" Margin="16,2,0,0">
                                <Border Style="{StaticResource Skeleton}" Width="260" Height="18" />
                                <Border Style="{StaticResource Skeleton}" Width="180" Height="18" Margin="0,8,0,0" />
                                <Border Style="{StaticResource Skeleton}" Width="140" Height="12" Margin="0,12,0,0" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="영상 정보를 불러오는 중…" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="기다리지 않고 바로 다운로드할 수도 있어요" />
                        </StackPanel>
                    </Grid>

                    <!-- 영상 정보 -->
                    <Grid x:Name="PreviewInfo" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="256" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="256" Height="144" VerticalAlignment="Top">
                            <Border CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <ui:Image x:Name="ImgThumb" CornerRadius="8" Stretch="UniformToFill" />
                            <Border x:Name="BadgeDuration" Margin="6" Padding="6,1" CornerRadius="4" Background="#CC000000"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock x:Name="TxtDuration" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock x:Name="TxtTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="44" />
                            <TextBlock x:Name="TxtMeta" Margin="0,4,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:SymbolIcon x:Name="IconVideoChips" Symbol="Video20" FontSize="16" Margin="0,2,0,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="영상 해상도" />
                                <ItemsControl x:Name="VideoChips" Grid.Column="1" Style="{StaticResource Chips}" />
                                <ui:SymbolIcon x:Name="IconAudioChips" Grid.Row="1" Symbol="MusicNote220" FontSize="16" Margin="0,2,0,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="오디오 음질" />
                                <ItemsControl x:Name="AudioChips" Grid.Row="1" Grid.Column="1" Style="{StaticResource Chips}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- 오류 -->
                    <StackPanel x:Name="PreviewError" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="32" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="영상 정보를 불러오지 못했습니다" />
                        <TextBlock x:Name="TxtPreviewError" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" FontSize="12" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 다운로드 옵션 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,18">
                <StackPanel>
                    <!-- 작업 중 잠그는 입력 -->
                    <StackPanel x:Name="OptionsInputs">
                    <!-- 모드 선택 (오디오 / 영상) -->
                    <Border HorizontalAlignment="Left" Padding="3" CornerRadius="7"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbAudio" Style="{StaticResource Segment}" GroupName="Mode" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Margin="6,0,0,0" Text="오디오" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbVideo" Style="{StaticResource Segment}" GroupName="Mode">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Video24" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Margin="6,0,0,0" Text="영상" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- 포맷 / 품질 -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="포맷" />
                            <ComboBox x:Name="CboFormat" SelectionChanged="CboFormat_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="LblQuality" Style="{StaticResource FieldLabel}" Text="음질" />
                            <ComboBox x:Name="CboQuality" />
                        </StackPanel>
                    </Grid>

                    <!-- 추가 옵션 -->
                    <WrapPanel Margin="0,18,0,0">
                        <ui:ToggleSwitch x:Name="ChkThumbnail" Content="썸네일 삽입" IsChecked="True" Margin="0,0,28,0"
                                         ToolTip="MP3 / M4A / OPUS / FLAC / MP4 / MKV에서만 지원됩니다." />
                        <ui:ToggleSwitch x:Name="ChkMetadata" Content="메타데이터 삽입" IsChecked="True" Margin="0,0,28,0"
                                         ToolTip="제목, 업로더, 날짜 등을 파일 태그에 기록합니다." />
                        <ui:ToggleSwitch x:Name="ChkPlaylist" Content="재생목록 전체" Click="ChkPlaylist_Click"
                                         ToolTip="URL에 재생목록이 포함된 경우 전체를 '재생목록 이름' 하위 폴더에 받습니다.&#x0a;해제 시 해당 영상 하나만 받습니다." />
                    </WrapPanel>
                    </StackPanel>

                    <Border Height="1" Margin="0,18" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!-- 저장 위치 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Folder24" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="저장 위치" />
                            <TextBlock x:Name="TxtOutputDir" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ui:Button x:Name="BtnBrowse" Grid.Column="2" Content="변경" Click="BtnBrowse_Click" />
                        <ui:Button Grid.Column="3" Margin="8,0,0,0" Icon="{ui:SymbolIcon FolderOpen24}" Content="열기" Click="BtnOpenFolder_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 결과 알림 -->
            <ui:InfoBar x:Name="Notice" Margin="0,12,0,0" IsClosable="True" />
        </StackPanel>

        <!-- ================= 하단: 진행률 / 다운로드 ================= -->
        <Border Grid.Row="2" Padding="24,14,24,18" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="준비됨" />
                    <ProgressBar x:Name="Progress" Margin="0,8,0,0" Maximum="1000" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnCancel" Content="취소" Height="36" Padding="16,0" Visibility="Collapsed" Click="BtnCancel_Click" />
                    <ui:Button x:Name="BtnDownload" Margin="8,0,0,0" Height="36" MinWidth="128" Appearance="Primary" IsDefault="True"
                               Icon="{ui:SymbolIcon ArrowDownload24}" Content="다운로드" Click="BtnDownload_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
